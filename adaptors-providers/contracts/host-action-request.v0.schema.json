{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIVIM Labs Host outbound action proposal — no authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "intent",
    "providerId",
    "accountRef",
    "destination",
    "draftRef",
    "approvalPolicy",
    "expectedBinding"
  ],
  "properties": {
    "schema": {
      "const": "vivim.labs.host-action-request/0.1"
    },
    "status": {
      "const": "PROPOSAL_ONLY"
    },
    "intent": {
      "enum": [
        "message.compose",
        "message.send",
        "comment.create",
        "reaction.toggle",
        "post.publish",
        "draft.save"
      ]
    },
    "providerId": {
      "type": "string"
    },
    "accountRef": {
      "type": "string"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadRef",
        "recipientRefs"
      ],
      "properties": {
        "threadRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipientRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "providerOrigin": {
          "type": "string"
        }
      }
    },
    "draftRef": {
      "type": "string",
      "description": "Host private draft ID, not text; exact bytes must be revealed in trusted confirmation"
    },
    "attachmentRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicitConfirmation",
        "requiresFreshSourceGrant",
        "requiresPreSendRecheck"
      ],
      "properties": {
        "explicitConfirmation": {
          "const": true
        },
        "requiresFreshSourceGrant": {
          "const": true
        },
        "requiresPreSendRecheck": {
          "const": true
        }
      }
    },
    "expectedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountIdentity",
        "threadIdentity",
        "destinationOrigin"
      ],
      "properties": {
        "accountIdentity": {
          "type": "string"
        },
        "threadIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "destinationOrigin": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
