{
  "schema": "vivim-labs.tech-stack.workspaces/1",
  "source_commit": "f9823a5131e73e7562db5a4ec14e1ec481557d69",
  "root_js_workspaces": [
    "apps/vivim-host",
    "apps/mobile-relay",
    "studio",
    "harness",
    "hq",
    "packages/tierflow"
  ],
  "root_rust_members": [
    "native/hqkg",
    "core/programmability",
    "src-tauri"
  ],
  "entries": [
    {
      "path": "apps/vivim-host",
      "kind": "node",
      "role": "Host effect owner, onboarding, control, World",
      "runtime": "Node >=22 package; root >=24",
      "external_packages": []
    },
    {
      "path": "apps/mobile-relay",
      "kind": "node+pwa",
      "role": "Paired mobile and optional relay",
      "runtime": "Browser + optional Vercel function",
      "external_packages": [
        "@vercel/blob@2.8.2"
      ]
    },
    {
      "path": "studio",
      "kind": "node",
      "role": "Chrome CDP capture, profiling, discovery",
      "runtime": "Node >=22 package; root >=24",
      "external_packages": []
    },
    {
      "path": "harness",
      "kind": "node",
      "role": "Signed-in webapp interactions",
      "runtime": "Node >=22 package; root >=24",
      "external_packages": []
    },
    {
      "path": "hq",
      "kind": "node",
      "role": "Rebuildable development indexing/search/wiki",
      "runtime": "Node >=24; node:sqlite",
      "external_packages": []
    },
    {
      "path": "packages/tierflow",
      "kind": "typescript+bun",
      "role": "Visual runtime/projection",
      "runtime": "Bun tools; browser runtime",
      "external_packages": [
        "typescript@^7.0.2",
        "@typescript/native-preview@^7.0.0-dev.20260707.2",
        "bun-types@latest"
      ]
    },
    {
      "path": "core/programmability",
      "kind": "rust",
      "role": "Pure deterministic typed transformations",
      "runtime": "Rust 1.99.0 workspace toolchain",
      "external_packages": [
        "serde@1",
        "serde_json@1",
        "sha2@0.10"
      ]
    },
    {
      "path": "native/hqkg",
      "kind": "rust",
      "role": "Graph, importer and optional persistence",
      "runtime": "Rust 1.99.0 workspace; crate MSRV 1.74",
      "external_packages": [
        "rusqlite@0.32 optional",
        "postgres@0.19 optional",
        "serde_json@1 optional",
        "sha2@0.10 optional"
      ]
    },
    {
      "path": "src-tauri",
      "kind": "rust+desktop",
      "role": "Windows Tauri shell launching Host",
      "runtime": "Rust 1.99.0",
      "external_packages": [
        "tauri@=2.0.0",
        "tauri-runtime@=2.0.0",
        "tauri-runtime-wry@=2.0.0",
        "tauri-utils@=2.0.0",
        "tauri-build@=2.0.0",
        "windows@=0.58.0",
        "windows-core@=0.58.0",
        "webview2-com-sys@=0.33.0",
        "tokio@1",
        "reqwest@0.12"
      ]
    }
  ]
}
