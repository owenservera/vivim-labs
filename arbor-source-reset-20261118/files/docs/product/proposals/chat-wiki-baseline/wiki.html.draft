<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VIVIM — realtime wiki</title>
<link rel="stylesheet" href="/vivim-tokens.css">
<style>
  :root { color-scheme: dark; }
  body { margin: 0; background: var(--bg-primary, #0d0f12); color: var(--text-primary, #e8eaed);
         font-family: var(--font-body, system-ui, sans-serif); height: 100vh; display: flex; flex-direction: column; }
  header { padding: 12px 16px; border-bottom: 1px solid var(--border-subtle, #23262b); display: flex; gap: 12px; align-items: baseline; }
  header h1 { font-size: 15px; margin: 0; font-weight: 600; }
  header a { color: var(--accent, #7aa2f7); font-size: 12px; text-decoration: none; }
  header .rev { font-size: 11px; opacity: .6; margin-left: auto; }
  main { flex: 1; overflow-y: auto; padding: 20px 28px; max-width: 900px; }
  .page { margin-bottom: 28px; }
  .page > h2 { font-size: 18px; margin: 0 0 12px; border-bottom: 1px solid var(--border-subtle, #23262b); padding-bottom: 6px; }
  .section { margin-bottom: 16px; }
  .section h3 { font-size: 13px; margin: 0 0 6px; text-transform: uppercase; letter-spacing: .06em; opacity: .75; }
  .section .body { font-size: 14px; line-height: 1.6; white-space: pre-wrap; }
  .empty { opacity: .5; font-size: 13px; }
</style>
</head>
<body>
<header>
  <h1>VIVIM realtime wiki</h1>
  <a href="/demo/chat">chat</a>
  <a href="/demo">dev panel</a>
  <span class="rev" id="rev"></span>
</header>
<main id="content"></main>
<script type="module">
  const content = document.getElementById('content');
  const rev = document.getElementById('rev');
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  async function refresh() {
    const w = await (await fetch('/demo/wiki-data')).json();
    rev.textContent = 'wiki rev ' + (w.revision ?? 0);
    const pages = w.pages ?? {};
    const names = Object.keys(pages);
    if (!names.length) { content.innerHTML = '<div class="empty">wiki is empty — edit it from chat</div>'; return; }
    content.innerHTML = names.map((name) => {
      const secs = pages[name]?.sections ?? {};
      return `<div class="page" data-wiki-page="${esc(name)}"><h2>${esc(name)}</h2>`
        + Object.keys(secs).map((s) => `<div class="section" data-wiki-id="${esc(name)}/${esc(s)}"><h3>${esc(s)}</h3><div class="body">${esc(secs[s])}</div></div>`).join('')
        + `</div>`;
    }).join('');
  }
  refresh();
  setInterval(refresh, 1000);
</script>
</body>
</html>
