{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vivim.live/schemas/application-profile-baseline/1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","target","profiles"],
  "properties":{
    "schema":{"const":"vivim.application-profile-baseline/1"},
    "target":{"type":"object","additionalProperties":false,"required":["siteId","origin"],"properties":{
      "siteId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,79}$"},"origin":{"type":"string","minLength":8}
    }},
    "description":{"type":"string","maxLength":300},
    "profiles":{"type":"array","minItems":1,"maxItems":2,"items":{"type":"object","additionalProperties":false,
      "required":["owner","sourcePath","features"],
      "properties":{
        "owner":{"enum":["studio","harness"]},
        "sourcePath":{"type":"string","maxLength":320},
        "sourceBlobSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "features":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,
          "required":["id","surface","sourceStatus","selectors","matchTerms"],
          "properties":{
            "id":{"type":"string","pattern":"^[a-z][a-z0-9.-]{1,96}$"},
            "surface":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
            "sourceStatus":{"enum":["configured","source-measured","unverified"]},
            "selectors":{"type":"array","maxItems":25,"items":{"type":"string","maxLength":320}},
            "matchTerms":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":70}},
            "notes":{"type":"string","maxLength":300}
          }
        }}
      }
    }}
  }
}
