<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VIVIM — chat</title>
<link rel="stylesheet" href="/vivim-tokens.css">
<style>
  :root { color-scheme: dark; }
  body { margin: 0; background: var(--bg-primary, #0d0f12); color: var(--text-primary, #e8eaed);
         font-family: var(--font-body, system-ui, sans-serif); display: flex; flex-direction: column; height: 100vh; }
  header { padding: 12px 16px; border-bottom: 1px solid var(--border-subtle, #23262b); display: flex; gap: 12px; align-items: baseline; }
  header h1 { font-size: 15px; margin: 0; font-weight: 600; }
  header a { color: var(--accent, #7aa2f7); font-size: 12px; text-decoration: none; }
  header .rev { font-size: 11px; opacity: .6; }
  #log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .msg { max-width: 760px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border-subtle, #23262b); background: var(--bg-secondary, #14161a); }
  .msg.user { align-self: flex-end; background: var(--accent-dim, #1a2333); }
  .msg .who { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; opacity: .55; margin-bottom: 3px; }
  .msg .text { font-size: 14px; white-space: pre-wrap; }
  .intent { margin-top: 6px; font-size: 11px; font-family: var(--font-mono, monospace); opacity: .8; border-top: 1px dashed var(--border-subtle, #23262b); padding-top: 5px; }
  .intent .outcome { padding: 1px 6px; border-radius: 6px; background: #232a35; }
  .intent .outcome.candidate { background: #14301c; color: #7ee2a8; }
  .intent .outcome.refused { background: #3a1616; color: #ff9d9d; }
  .intent .canonical { color: var(--accent, #7aa2f7); }
  form { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--border-subtle, #23262b); }
  input { flex: 1; background: var(--bg-secondary, #14161a); border: 1px solid var(--border-subtle, #23262b);
          color: inherit; border-radius: 8px; padding: 10px 12px; font-size: 14px; }
  button { background: var(--accent, #7aa2f7); border: 0; border-radius: 8px; padding: 10px 16px; font-size: 14px; cursor: pointer; }
</style>
</head>
<body>
<header>
  <h1>VIVIM chat</h1>
  <a href="/demo/wiki">wiki</a>
  <a href="/demo">dev panel</a>
  <span class="rev" id="rev"></span>
</header>
<div id="log"></div>
<form id="f">
  <input id="t" autocomplete="off" placeholder="Type to VIVIM — natural language in, deterministic command out">
  <button>send</button>
</form>
<script type="module">
  const log = document.getElementById('log');
  const rev = document.getElementById('rev');
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function renderMsg(m) {
    const el = document.createElement('div');
    el.className = 'msg ' + (m.who === 'user' ? 'user' : 'system');
    let intent = '';
    if (m.intent) {
      const o = m.intent.outcome ?? 'none';
      intent = `<div class="intent"><span class="outcome ${String(o).replace('_','')}">${esc(o)}</span>`
        + (m.intent.canonical ? ` <span class="canonical">${esc(m.intent.canonical)}</span>` : '')
        + (m.intent.refusal ? ` ${esc(m.intent.refusal.message ?? '')}` : '') + `</div>`;
    }
    el.innerHTML = `<div class="who">${esc(m.who)}${m.at ? ' · ' + esc(m.at) : ''}</div><div class="text">${esc(m.text)}</div>${intent}`;
    return el;
  }
  async function refresh() {
    const s = await (await fetch('/demo/state')).json();
    rev.textContent = 'state rev ' + (s.wikiRevision ?? 0);
    log.replaceChildren(...(s.chat ?? []).map(renderMsg));
    log.scrollTop = log.scrollHeight;
  }
  document.getElementById('f').addEventListener('submit', async (e) => {
    e.preventDefault();
    const t = document.getElementById('t');
    const text = t.value.trim();
    if (!text) return;
    t.value = '';
    await fetch('/demo/chat-send', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text, who: 'user' }) });
    await refresh();
  });
  refresh();
  setInterval(refresh, 1500);
</script>
</body>
</html>
