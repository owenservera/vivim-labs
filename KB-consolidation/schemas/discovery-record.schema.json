{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIVIM data surface discovery record",
  "type": "object",
  "required": [
    "id",
    "kinds",
    "source",
    "evidence_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "path",
        "revision"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "backing_store": {
      "type": [
        "string",
        "null"
      ]
    },
    "durability": {
      "type": [
        "string",
        "null"
      ]
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation",
          "target"
        ]
      }
    },
    "evidence_status": {
      "enum": [
        "observed-source",
        "tested",
        "runtime-verified",
        "documented-only",
        "unknown",
        "conflicting"
      ]
    },
    "disposition": {
      "enum": [
        "KEEP",
        "CONNECT",
        "CONSOLIDATE",
        "MIGRATE",
        "RETIRE",
        "INVESTIGATE"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
