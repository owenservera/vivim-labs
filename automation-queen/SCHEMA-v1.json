{
  "schemaVersion": "automation-queen-intake/1.0",
  "visibility": "PUBLIC_SCHEMA_ONLY",
  "note": "Canonical public schema description. Private records live only in gitignored local path; do not commit sensitive field values.",
  "recordTypes": {
    "source": {
      "required": [
        "sourceId",
        "sourceKind",
        "originVisibility",
        "collectedAtUtc",
        "originalSha256",
        "classification",
        "copyDisposition",
        "liveness",
        "evidenceLevel"
      ],
      "properties": {
        "sourceId": "stable UUID or scoped hashed identifier; public manifests must use nonreversible surrogate",
        "sourceKind": "git-file|git-history|local-file|scheduled-task|service|startup|process|tool-install|runtime-observation|documentation|other",
        "originVisibility": "public|private|local-only|unknown",
        "collectionOrigin": "full original source path/URL and git commit in PRIVATE manifest only",
        "collectedAtUtc": "ISO-8601",
        "originalSha256": "hex SHA256; private manifest only by default",
        "sanitizedSha256": "SHA256 of approved public derivative; when applicable",
        "classification": "PUBLIC_SAFE|PRIVATE_CODE|LOCAL_SENSITIVE|SECRET_REF_ONLY|CREDENTIAL_DENY|UNKNOWN_REVIEW",
        "copyDisposition": "PUBLIC_MIRROR|LOCAL_PRIVATE_MIRROR|REF_ONLY|SKIP|BLOCKED",
        "liveness": "observed_running|configured|implemented_unproven|docs_only|historical|unknown",
        "evidenceLevel": "raw-exit|runtime-observed|source-verified|docs-claim|inferred|unknown",
        "fileType": "agent|workflow|trigger|schedule|tool|MCP|ACP|skill|hook|policy|model-router|context|memory|bus|supervisor|executor|test|release|ui|prompt|docs|other",
        "capabilityIds": "list of canonical capability IDs",
        "dependsOn": "list of sourceId relations",
        "ownerAuthority": "who may invoke effects; NEVER infer from existence",
        "testEvidenceRefs": "evidence IDs or UNKNOWN",
        "license": "origin license/NOTICE and reuse restrictions",
        "collectionReceipt": "timestamp, collector version, verified copy hash, copy destination classification",
        "riskFlags": "secret|privacy|irreversible-effect|duplication|stale|unsafe-trigger|unbounded-cost|other",
        "decision": "KEEP|ADAPT|MERGE|RETIRE|ARCHIVE|UNKNOWN"
      }
    },
    "relation": {
      "required": [
        "fromId",
        "toId",
        "relationType",
        "evidenceRef"
      ],
      "relationType": [
        "defines",
        "calls",
        "dispatches",
        "depends_on",
        "triggers",
        "authorizes",
        "observes",
        "records",
        "replaces",
        "duplicates",
        "derived_from",
        "implements",
        "tests",
        "conflicts_with"
      ]
    },
    "capability": {
      "required": [
        "capabilityId",
        "description",
        "candidateOwner",
        "authorityBoundary",
        "implementations",
        "evidenceState"
      ],
      "evidenceState": [
        "PASS",
        "FAIL",
        "UNRUN",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "coverage": {
      "required": [
        "scanId",
        "scope",
        "status",
        "attemptedAtUtc",
        "itemsFound",
        "excludedCount",
        "blockers"
      ],
      "status": [
        "COMPLETE_WITH_LIMITS",
        "PARTIAL",
        "BLOCKED",
        "NOT_STARTED"
      ]
    },
    "gate": {
      "required": [
        "gateId",
        "status",
        "evidenceRefs"
      ],
      "status": [
        "PASS",
        "FAIL",
        "UNRUN",
        "BLOCKED"
      ]
    }
  },
  "requiredArtifacts": [
    "PRIVATE-SOURCE-MANIFEST.jsonl (gitignored)",
    "PUBLIC-MANIFEST.jsonl (sanitized only)",
    "PUBLIC-ATLAS.md",
    "SYSTEM-ATLAS.private.md (gitignored)",
    "DUPLICATES.private.jsonl (gitignored)",
    "GAP-REGISTER.md (redacted)",
    "QUEEN-BLUEPRINT.md (public-safe)",
    "COLLECTION-RECEIPTS.private.jsonl (gitignored)"
  ],
  "neverPublish": [
    "credentials",
    "OAuth cookies/session tokens",
    "SSH keys",
    "raw chat sessions",
    "private source tree",
    "personal home paths",
    "signed-in browser profiles",
    "private company internals without explicit review"
  ]
}
