          "from": "const [arbor,source,data,binary]=process.argv.slice(2);",
          "to": "const [arbor,source,data,binary,watchFlag,...extra]=process.argv.slice(2);\nif(extra.length||watchFlag!==undefined&&watchFlag!=='--watch')throw Error('INVALID_SESSION_OPTION');\nconst watching=watchFlag==='--watch';"
