{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIVIM production fact tracker",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "capability_id",
      "state",
      "build_sha",
      "device_or_environment",
      "observed_at",
      "evidence_refs"
    ],
    "properties": {
      "capability_id": {
        "type": "string"
      },
      "state": {
        "enum": [
          "unknown",
          "not_deployed",
          "staged",
          "deployed",
          "active_verified",
          "suspended",
          "retired"
        ]
      },
      "build_sha": {
        "type": [
          "string",
          "null"
        ]
      },
      "device_or_environment": {
        "type": [
          "string",
          "null"
        ]
      },
      "observed_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "owner_grant_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "rollback_ref": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
