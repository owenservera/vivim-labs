  "authority": "candidate evidence only; existing ARBOR Host catalog owns execution",
  "packages": [
    {
      "id": "WNI01",
      "name": "filesystem-delta",
      "priority": "P0",
      "source": [
        "https://learn.microsoft.com/en-us/windows/win32/fileio/using-the-change-journal-identifier",
        "https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-readdirectorychangesw"
      ],
      "owner": "native Host + HQ",
      "code": "src/change.rs (parser and revision reducer; OS reader pending)",
      "extract": "Use ReadDirectoryChangesW on explicitly approved directories as the default non-elevated watcher. Open directory handle with FILE_LIST_DIRECTORY and shared read/write/delete; cancel with CancelIoEx or worker shutdown. Treat zero bytes, ERROR_NOTIFY_ENUM_DIR and bounded queue overflow as a gap. USN_QUERY/READ are optional privileged NTFS capabilities; no auto-elevation, volume-wide filename ingestion or journal creation. Persist journal ID plus cursor only after authorized batch commit. Re-scan approved scope on journal rotation or gap. Do not reconstruct global private file paths from raw volume records.",
      "accept": "Real temp directory create/rename/delete; restart cursor; force gap, rebaseline; non-admin USN refusal; verify no events from unapproved roots.",
      "actionIds": [
        "windows.filesystem.changes.status",
        "windows.filesystem.changes.read",
        "windows.filesystem.changes.configure"
      ]
    },
    {
      "id": "WNI02",
      "name": "system-diagnostics",
      "priority": "P0",
      "source": [
        "https://learn.microsoft.com/en-us/windows/win32/etw/about-event-tracing",
        "https://learn.microsoft.com/en-us/windows/win32/etw/consuming-events",
        "https://learn.microsoft.com/en-us/windows/win32/api/sysinfoapi/nf-sysinfoapi-globalmemorystatusex",
        "https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-getsystemtimes"
      ],
      "owner": "native Host + workstation",
      "code": "src/resources.rs (native aggregate CPU/memory and selected fixed-drive capacity); ETW adapter pending",
      "extract": "Aggregate memory and system CPU deltas through Win32; report unavailable for unsupported processor group coverage rather than imply whole-machine certainty. Drive capacity only for an approved fixed drive. ETW start with VIVIM-owned provider and owned task correlation; StartTrace/EnableTraceEx2/OpenTrace/ProcessTrace with cancellation and bounded event queue; TDH decode allowlisted fields. No command lines, unrelated process payloads, credentials, network payloads or persistent system-wide tracing by default. Preserve dropped-event count; correlate owned process creation time + session ID, not PID alone.",
      "accept": "Compare memory/capacity to native OS APIs, verify nonzero CPU delta and invalid sample refusal; emit one owned event, verify correlation, stop and verify no remaining trace session.",
      "actionIds": [
        "windows.system.resources.read",
        "windows.system.volume.capacity",
        "windows.system.diagnostics.read",
        "windows.system.diagnostics.configure"
      ]
    },
    {
      "id": "WNI03",
      "name": "native-terminal-agents",
      "priority": "P0",
      "source": [
        "https://github.com/microsoft/intelligent-terminal/blob/7ef2e637b810d58f20ef53f61275a0ec849cf26f/tools/wta/OVERVIEW.md",
        "https://github.com/microsoft/intelligent-terminal/blob/7ef2e637b810d58f20ef53f61275a0ec849cf26f/doc/agent-profiles.md",
        "https://github.com/microsoft/intelligent-terminal/blob/7ef2e637b810d58f20ef53f61275a0ec849cf26f/doc/security-model.md",
        "https://learn.microsoft.com/en-us/windows/console/createpseudoconsole"
      ],
      "owner": "workstation + Host",
      "code": "src/session.rs (receipt-fenced lifecycle reducer); ConPTY and ACP transport pending",
      "extract": "Donor WTA master pools agent CLI connections and routes ACP sessions to owners. Reuse protocol discovery and lifecycle ideas; do not copy its renderer, COM terminal controller, named-pipe server or install another terminal. Extend existing Windows Job Object worker with optional CreatePseudoConsole, separate pipe IO, PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE and deterministic shutdown. ACP profile selection uses existing provider registry and cost policy. Keep approval/receipt authority in Host; treat delegate proposals as proposals, not completed effects.",
      "accept": "Real ConPTY echo/resize/interrupt, no stuck handles, child cancellation, two owned ACP sessions with no output mix-up, settled receipt and no unexpected provider charges.",
      "actionIds": [
        "windows.terminal.capabilities.read",
        "windows.agent.sessions.list",
        "windows.agent.session.status",
        "windows.agent.session.start",
        "windows.agent.session.cancel"
      ]
    },
    {
      "id": "WNI04",
      "name": "indexed-search",
      "priority": "P0",
      "source": [
        "https://learn.microsoft.com/en-us/windows/win32/search/using-sql-and-aqs-to-query-the-index",
        "https://learn.microsoft.com/en-us/windows/win32/properties/props-system-itempathdisplay"
      ],
      "owner": "HQ + existing file port",
      "code": "adapter recipe only",
      "extract": "Use Windows Search OLE DB SystemIndex with fixed SELECT fields, bounded results and properly escaped literal input; never accept caller-supplied SQL. Resolve scope from Host grant, filter returned paths against approved canonical roots and recheck access before opening; index hits are candidate evidence, not proof of current contents. Windows Property System IPropertyStore for allowlisted file metadata. Fall back to existing HQ index, never silently index the whole machine. COM initialization and cleanup on dedicated worker.",
      "accept": "Known authorized fixture indexed, query matches it, out-of-scope hit withheld, stale/missing file clearly marked, service disabled fallback; query-injection test.",
      "actionIds": [
        "windows.knowledge.search.status",
        "windows.knowledge.search.query",
        "windows.knowledge.file.properties"
      ]
    },
    {
      "id": "WNI05",
      "name": "native-app-semantics",
      "priority": "P0",
      "source": [
        "https://github.com/microsoft/winappCli/blob/c9e6a9bdf010add8edaddb790689e3cbaae33cd5/docs/ui-automation.md",
        "https://github.com/microsoft/winappCli/blob/c9e6a9bdf010add8edaddb790689e3cbaae33cd5/src/winapp-CLI/WinApp.UIAutomation/PACKAGE.md",
        "https://learn.microsoft.com/en-us/windows/win32/winauto/uiauto-eventsoverview"
      ],
      "owner": "dedicated Studio/Harness convergence",
      "code": "donor extraction recipe only; R033 hold on integration",
      "extract": "Port semantic selector, element identity, wait-for assertion and cooperative desktop-turn arbitration into existing Studio/Harness. Rust windows COM UIA, selected app only; mask password controls, no arbitrary desktop recording; actions must be registered and authorized. Bind window identity + runtime ID + semantic fingerprint + observed revision. Reject stale selectors, serialize focus ownership and read back after action. No WinApp UI runtime or browser controller; library donor is .NET, so use patterns only unless approved otherwise.",
      "accept": "Notepad fixture unique selector, ambiguous selector refusal, state change invalidates stale revision, selected-app readback, no competing renderer or focus contention.",
      "actionIds": [
        "windows.application.inspect",
        "windows.application.element.query",
        "windows.application.action.invoke"
      ]
    },
    {
      "id": "WNI06",
      "name": "app-actions",
      "priority": "P0",
      "source": [
        "https://learn.microsoft.com/en-us/windows/ai/app-actions/",
        "https://learn.microsoft.com/en-us/windows/ai/app-actions/actions-consume"
      ],
      "owner": "Studio/Harness + VLANG registry",
      "code": "adapter recipe only; SDK availability probe required",
      "extract": "Microsoft.AI.Actions consumer SDK is documented; verify package identity, OS version, supported provider registration and Rust/WinRT accessibility before choosing a minimal adapter. Import action metadata as proposed semantic IDs; never auto-promote discovery to execution rights. Bind typed arguments, target identity and risk through Host. Optional adapter, no Copilot dependency, no blanket claim every app supports actions.",
      "accept": "On supported Windows, discover documented fixture provider, invoke harmless typed action after Host approval, verify output; unavailable platform returns explicit unsupported; reject arbitrary action ID.",
      "actionIds": [
        "windows.application.actions.discover",
        "windows.application.action.describe",
        "windows.application.action.execute"
      ]
    },
    {
      "id": "WNI07",
      "name": "windows-capture",
      "priority": "P1",
      "source": [
        "https://learn.microsoft.com/en-us/windows/uwp/audio-video-camera/screen-capture",
        "https://github.com/microsoft/winappCli/blob/c9e6a9bdf010add8edaddb790689e3cbaae33cd5/src/winapp-CLI/WinApp.UIAutomation/PACKAGE.md"
      ],
      "owner": "dedicated Studio/Harness + GPUI",
      "code": "donor extraction recipe only",
      "extract": "Use Windows Graphics Capture picker or supported owner-consented selected-window API; keep session visible and revocable. Capture limited to selected app, no covert desktop surveillance, credential windows excluded, no frames in public evidence. Use GPUI existing render/capture paths; no second renderer or browser surface. Return authorized artifact ref and revision, not raw frames in routine MCP tool responses.",
      "accept": "Owner selects test window; verify scope, stop/revoke, minimized/occluded support reported accurately, phone and GPUI state consistent; refuse nonselected target.",
      "actionIds": [
        "windows.application.capture.status",
        "windows.application.capture.request",
        "windows.application.capture.stop"
      ]
    },
    {
      "id": "WNI08",
      "name": "configuration-reconciliation",
      "priority": "P1",
      "source": [
        "https://learn.microsoft.com/en-us/windows/package-manager/configuration/",
        "https://learn.microsoft.com/en-us/powershell/dsc/overview"
      ],
      "owner": "Settings + Host",
      "code": "adapter recipe only",
      "extract": "Read-only inventory first; existing Settings stores desired state. WinGet/DSC optional supported commands, version probe, pinned trusted manifests. Plan diff before mutation; exact Host approval; only supported owner-selected packages, no silent elevation, install scripts or broad security setting changes. Track source digest and readback; rollback only where supported. Do not make DSC or WinGet a mandatory service.",
      "accept": "Read installed versions, plan known harmless fixture, demonstrate dry-run leaves state unchanged; approved apply with readback and explicit rollback capability.",
      "actionIds": [
        "windows.system.configuration.inspect",
        "windows.system.configuration.plan",
        "windows.system.configuration.apply"
      ]
    },
    {
      "id": "WNI09",
      "name": "workload-isolation",
      "priority": "P1",
      "source": [
        "https://learn.microsoft.com/en-us/windows/apps/develop/mxc/",
        "https://learn.microsoft.com/en-us/windows/apps/develop/mxc/releases"
      ],
      "owner": "native workstation + Host",
      "code": "optional backend recipe only",
      "extract": "Probe Microsoft Execution Containers supported backends before dependency adoption; optional mxc-sdk feature, explicit policy and trust model, no host prep by default. Existing Job Object process containment is lifecycle control, not sandbox. Use isolation for approved delegated workload only; never silently downgrade a requested isolation guarantee.",
      "accept": "Supported backend starts fixture with specified resources, unauthorized resource denied, stop cleans workload, unsupported backend fails closed; record memory/disk overhead.",
      "actionIds": [
        "windows.workload.isolation.status",
        "windows.workload.isolation.plan",
        "windows.workload.isolation.run"
      ]
    },
    {
      "id": "WNI10",
      "name": "hardware-adaptive-ai",
      "priority": "P2",
      "source": [
        "https://learn.microsoft.com/en-us/windows/ai/overview",
        "https://learn.microsoft.com/en-us/windows/ai/apis/"
      ],
      "owner": "native intelligence + model registry",
      "code": "adapter recipe only",
      "extract": "Probe supported Windows ML/Foundry execution providers and OS/hardware requirements. Use existing model registry and explicit resource budgets; no automatic model downloads, paid fallback or assumption of NPU. Small CPU task benchmarks first. Keep local inference optional; feed bounded typed outputs to existing verifier/semantic engine. Preserve model license and data provenance.",
      "accept": "Known permitted local fixture, compare latency/RAM/accuracy vs incumbent deterministic method; unsupported GPU/NPU path marked unavailable; no network fallback.",
      "actionIds": [
        "windows.intelligence.local.status",
        "windows.intelligence.local.evaluate"
      ]
    },
    {
      "id": "WNI11",
      "name": "binding-minimization",
      "priority": "P0",
      "source": [
        "https://github.com/microsoft/windows-rs",
        "https://docs.rs/windows-sys/0.61.2/windows_sys/"
      ],
      "owner": "native engineering",
      "code": "Cargo.toml feature list + dependency budget",
      "extract": "Use incumbent windows-sys 0.61.2 and narrowly scoped Win32 features for raw APIs. Use windows only where COM/WinRT requires it and verify incremental build/disk footprint. No wholesale framework or global package installs. Generate specialized bindings only if measurements justify; pin SDK and license provenance. Capability support means runtime probe, not compile success.",
      "accept": "Cargo tree before/after, no new mandatory service or runtime, supported Windows tests, cold/warm build time and disk delta.",
      "actionIds": [
        "windows.system.native.support"
      ]
    }
  ],
